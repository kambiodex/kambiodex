# Copie para ".env" (que NÃO vai para o Git) e preencha. NUNCA coloque chave privada aqui.

# Endereços de acesso às redes de teste (RPC)
AMOY_RPC_URL=
BNB_TESTNET_RPC_URL=

# Carteira que será DONA da Factory depois do deploy (só o endereço público, 0x...)
OWNER_ADDRESS=

# WPOL (Polygon) / WBNB (BNB) da rede. Deixe vazio na testnet para criar um token de teste.
# Em rede principal, usar o endereço oficial conferido na fonte oficial (nunca inventar).
WRAPPED_NATIVE_ADDRESS=

# Só para o script SetFeeProtocol: pools separadas por vírgula
POOL_ADDRESSES=
